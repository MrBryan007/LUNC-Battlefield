    // ---------- Optional local Data Bridge ----------
    let bridgeTimer = null;
    let bridgeOk = false;

    async function pollLocalBridge() {
      try {
        const res = await fetch("http://127.0.0.1:8787/snapshot", { cache: "no-store" });
        if (!res.ok) throw new Error("bridge http " + res.status);
        const snap = await res.json();
        if (!snap || !snap.market) throw new Error("bad snapshot");

        if (snap.market.price > 0) {
          lastPrice = price;
          price = snap.market.price;
          lastPriceTs = Date.now();
          priceHistory.push(price);
          if (priceHistory.length > 40) priceHistory.shift();
          priceSource = SRC.GECKO;
          isLive = true;
        }
        if (snap.walls) {
          if (snap.walls.buyM > 0) buyWall = snap.walls.buyM;
          if (snap.walls.sellM > 0) sellWall = snap.walls.sellM;
          if (snap.walls.quality === "live") depthSource = SRC.BINANCE;
        }
        if (Array.isArray(snap.events)) {
          snap.events.forEach(ev => {
            if (ev.type === "liquidation" && ev.usd > 500) {
              const power = Math.min(2.8, 0.7 + ev.usd / 500000);
              const zz = (Math.random() - 0.5) * 15;
              if (ev.side === "long") {
                pushFeed("Liquidated long • $" + (ev.usd/1e6).toFixed(2) + "M  Bulls hit", "loss");
                createExplosion(targetX - 7, zz, 0xf87171, power);
              } else {
                pushFeed("Liquidated short • $" + (ev.usd/1e6).toFixed(2) + "M  Bears hit", "liq");
                createExplosion(targetX + 7, zz, tokens[current].color, power);
              }
            }
          });
        }
        if (snap.ecosystem) {
          const el = document.getElementById("tvlValue");
          if (el && snap.ecosystem.chainTvlUsd) {
            const v = snap.ecosystem.chainTvlUsd;
            el.textContent = v >= 1e6 ? "$"+(v/1e6).toFixed(2)+"M" : "$"+(v/1e3).toFixed(1)+"K";
          }
          const p = snap.ecosystem.protocols || {};
          const set = (id, val) => {
            const e = document.getElementById(id);
            if (!e || val == null) return;
            e.textContent = val >= 1e6 ? "$"+(val/1e6).toFixed(2)+"M" : "$"+(val/1e3).toFixed(1)+"K";
          };
          if (p.terraport) set("tvlTerraport", p.terraport.tvlUsd);
          if (p.garuda) set("tvlGaruda", p.garuda.tvlUsd);
          if (p.juris) set("tvlJuris", p.juris.tvlUsd);
        }
        bridgeOk = true;
        setStatus("PRICE · BRIDGE", "Local data bridge", true);
        return true;
      } catch (e) {
        bridgeOk = false;
        return false;
      }
    }

    function startBridgePoll() {
      if (bridgeTimer) return;
      pollLocalBridge();
      bridgeTimer = setInterval(pollLocalBridge, 2500);
    }

    // Boot data layer
    startGecko();
    startContextFeeds();
    startBridgePoll();
    if (tokens[current] && tokens[current].symbol) {
      connectBinance(tokens[current].symbol);
    }
    updateStatusUI();
    pushFeed("LUNC Ecosystem Battlefield", "win");
    pushFeed("WASD move · armies follow walls · burns & liqs strike", "info");

    // ========== MAIN LOOP ==========
    setInterval(() => {
      if (priceSource !== SRC.SIM && priceHistory.length > 5) {
        const recent = priceHistory.slice(-8);
        const delta = recent[recent.length-1] - recent[0];
        momentum = momentum * 0.72 + (delta / (price || 1)) * 35;
      } else if (priceSource === SRC.SIM) {
        momentum += (Math.random() - 0.47) * 0.18;
        momentum *= 0.88;
        const speed = current === "LUNC" ? 0.00000012 : current === "USTC" ? 0.00001 : 0.0000005;
        price += momentum * speed;
        if (price < tokens[current].base * 0.7) price = tokens[current].base * 0.7;
        if (price > tokens[current].base * 1.4) price = tokens[current].base * 1.4;
        lastPriceTs = Date.now();
        if (Math.random() < 0.12) {
          buyWall = Math.max(0.6, Math.min(6, buyWall + (Math.random() - 0.5) * 0.45));
          sellWall = Math.max(0.6, Math.min(6, sellWall + (Math.random() - 0.5) * 0.45));
        }
      }

      if (price > rangeHigh) {
        pushFeed("BULLS TAKE THE RANGE!", "win");
        showVictory(true);
        const mid = price;
        const half = (rangeHigh - rangeLow) * 0.5;
        rangeLow = mid - half;
        rangeHigh = mid + half;
        createExplosion(targetX, 0, tokens[current].color, 1.9);
        buyWall = Math.min(6, buyWall + 0.35);
      }
      if (price < rangeLow) {
        pushFeed("BEARS TAKE THE RANGE!", "loss");
        showVictory(false);
        const mid = price;
        const half = (rangeHigh - rangeLow) * 0.5;
        rangeLow = mid - half;
        rangeHigh = mid + half;
        createExplosion(targetX, 0, 0xf87171, 1.9);
        sellWall = Math.min(6, sellWall + 0.35);
      }

      const t = tokens[current];
      document.getElementById("battleRange").textContent =
        `NEW BATTLE ${rangeLow.toFixed(t.decimals)} – ${rangeHigh.toFixed(t.decimals)}  |  Bears ${rangeLow.toFixed(t.decimals)} | Bulls ${rangeHigh.toFixed(t.decimals)}`;
      document.getElementById("price").textContent = "$" + price.toFixed(t.decimals);

      const tickVal = (momentum * 55).toFixed(2);
      const tickEl = document.getElementById("tick");
      tickEl.textContent = (momentum >= 0 ? "+" : "") + tickVal + "%";
      tickEl.style.color = momentum >= 0 ? "#34d399" : "#f87171";

      const press = document.getElementById("pressure");
      if (momentum > 0.07) { press.textContent = "Buyers advancing"; press.className = "pressure buyers"; }
      else if (momentum < -0.07) { press.textContent = "Sellers pushing"; press.className = "pressure sellers"; }
      else { press.textContent = "Contested"; press.className = "pressure contested"; }

      if (!isLive) {
        buyWall = Math.max(0.5, buyWall + (Math.random()-0.5)*0.1);
        sellWall = Math.max(0.5, sellWall + (Math.random()-0.5)*0.1);
      }
      document.getElementById("buyWall").textContent = "$" + buyWall.toFixed(2) + "M";
      document.getElementById("sellWall").textContent = "$" + sellWall.toFixed(2) + "M";

      if (Date.now() - lastRebuild > 5000 && Math.random() < 0.12) rebuildUnits();

      if ((!isLive || Math.random() < 0.04) && tokens[current].hasBurns && Math.random() < 0.13) {
        const amount = (Math.random()*7 + 1.5).toFixed(1);
        pushFeed(`LUNC BURN ${amount}B → Massive Bull power surge`, "burn");
        createExplosion(targetX + (Math.random()-0.5)*10, (Math.random()-0.5)*15, 0xfbbf24, 2.15, true);
        buyWall = Math.min(6.5, buyWall + 0.45);
        momentum += 0.12;
        playBurn();
      }
    }, 700);

    // ========== ANIMATION ==========
    const clock = new THREE.Clock();
    function animate() {
      requestAnimationFrame(animate);
      const dt = clock.getDelta();
      updateWASD(dt);
      controls.update();

      if (cameraShake > 0.01) {
        camera.position.x += (Math.random()-0.5) * cameraShake * 0.35;
        camera.position.y += (Math.random()-0.5) * cameraShake * 0.2;
        cameraShake *= 0.88;
      }

      const mid = (rangeLow + rangeHigh) / 2;
      const span = Math.max(rangeHigh - rangeLow, 1e-12);
      targetX = ((price - mid) / span) * 30;
      battleLine.position.x += (targetX - battleLine.position.x) * 0.09;

      bulls.forEach(u => {
        const rank = u.userData.type;
        const desired = targetX - (6.5 + rank * 4.8);
        u.position.x += (desired - u.position.x) * 0.018;
        u.position.y = Math.sin(Date.now()*0.0028 + u.position.z) * 0.05;
      });
      bears.forEach(u => {
        const rank = u.userData.type;
        const desired = targetX + (6.5 + rank * 4.8);
        u.position.x += (desired - u.position.x) * 0.018;
        u.position.y = Math.sin(Date.now()*0.0028 + u.position.z + 1.5) * 0.05;
      });

      for (let i = projectiles.length - 1; i >= 0; i--) {
        const r = projectiles[i];
        const dx = r.userData.tx - r.position.x;
        r.position.x += Math.sign(dx) * Math.min(Math.abs(dx), r.userData.speed);
        r.position.y += Math.sin(Date.now()*0.01 + i) * 0.02;
        r.userData.life -= dt;
        if (Math.abs(dx) < 0.4 || r.userData.life <= 0) {
          createExplosion(r.position.x, r.position.z, r.userData.color, r.userData.power * 0.85);
          scene.remove(r);
          projectiles.splice(i, 1);
        }
      }

      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.userData.life -= dt * 1.1;
        p.position.x += p.userData.vx;
        p.position.y += p.userData.vy;
        p.position.z += p.userData.vz;
        p.userData.vy -= 0.02;
        p.material.opacity = Math.max(0, p.userData.life);
        p.scale.setScalar(Math.max(0.01, p.userData.life * 0.9));
        if (p.userData.life <= 0) { scene.remove(p); particles.splice(i, 1); }
      }

      greenLight.intensity = 2.2 + Math.sin(Date.now()*0.0016) * 0.7;
      redLight.intensity = 2.0 + Math.cos(Date.now()*0.0016) * 0.6;
      centerLight.intensity = 0.85 + Math.sin(Date.now()*0.0022) * 0.35;

      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener("resize", () => {
      camera.aspect = innerWidth / innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(innerWidth, innerHeight);
    });

    pushFeed("Ecosystem: Terraport + Garuda + Juris TVL live", "info");
    pushFeed("Click anywhere to enable sound", "info");
  </script>
</body>
</html>