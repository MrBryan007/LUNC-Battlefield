    let futWs = null;
    let localBids = {};
    let localAsks = {};
    let reconnectAttempts = 0;
    let reconnectTimer = null;
    let geckoTimer = null;
    let geckoFails = 0;

    function setStatus(main, detail, ok) {
      const el = document.getElementById("dataMode");
      if (el) {
        el.textContent = main;
        el.className = ok ? "live" : "error";
      }
      const ag = document.getElementById("agentStatus");
      if (ag) ag.textContent = detail || "";
      const pairEl = document.getElementById("pair");
      if (pairEl) {
        const label = priceSource === SRC.GECKO ? " · CoinGecko"
                    : priceSource === SRC.BINANCE ? " · Binance"
                    : " · Simulated";
        pairEl.textContent = (tokens[current] ? tokens[current].name : "LUNC/USDT") + label;
      }
    }

    function updateStatusUI() {
      const priceLabel = priceSource === SRC.GECKO ? "CoinGecko"
                       : priceSource === SRC.BINANCE ? "Binance"
                       : "Sim";
      const depthLabel = depthSource === SRC.BINANCE ? "Binance depth"
                       : "Est. walls";
      const ok = priceSource !== SRC.SIM;
      setStatus(
        ok ? ("PRICE · " + priceLabel.toUpperCase()) : "SIMULATION",
        "Depth: " + depthLabel,
        ok
      );
    }

    async function fetchGecko() {
      try {
        const url = "https://api.coingecko.com/api/v3/simple/price?ids=terra-luna&vs_currencies=usd&include_24hr_vol=true&include_24hr_change=true";
        const res = await fetch(url, { cache: "no-store" });
        if (!res.ok) throw new Error("HTTP " + res.status);
        const data = await res.json();
        const coin = data["terra-luna"];
        if (!coin || !coin.usd) throw new Error("No price");

        lastPrice = price;
        price = coin.usd;
        lastPriceTs = Date.now();
        priceHistory.push(price);
        if (priceHistory.length > 40) priceHistory.shift();

        if (depthSource !== SRC.BINANCE) {
          const vol = coin.usd_24h_vol || 5e6;
          const base = Math.max(0.7, Math.min(5, vol / 3.5e6));
          buyWall = base * (0.92 + Math.random() * 0.2);
          sellWall = base * (0.88 + Math.random() * 0.22);
        }

        geckoFails = 0;
        if (priceSource !== SRC.BINANCE) {
          priceSource = SRC.GECKO;
          isLive = true;
        }
        updateStatusUI();
        return true;
      } catch (e) {
        console.warn("[Gecko]", e.message || e);
        geckoFails++;
        if (geckoFails >= 3 && priceSource === SRC.GECKO) {
          priceSource = SRC.SIM;
          isLive = depthSource === SRC.BINANCE;
          updateStatusUI();
        }
        return false;
      }
    }

    function startGecko() {
      if (geckoTimer) return;
      fetchGecko();
      geckoTimer = setInterval(fetchGecko, 12000);
    }

    function calcWalls() {
      let bidSum = 0, askSum = 0;
      const levels = 12;
      Object.keys(localBids).map(Number).sort((a,b)=>b-a).slice(0,levels)
        .forEach(p => { bidSum += p * (localBids[p]||0); });
      Object.keys(localAsks).map(Number).sort((a,b)=>a-b).slice(0,levels)
        .forEach(p => { askSum += p * (localAsks[p]||0); });
      return { buy: bidSum/1e6, sell: askSum/1e6 };
    }

    function connectBinance(symbol) {
      if (!symbol) return;
      if (spotWs) { try { spotWs.onclose=null; spotWs.close(); } catch(e){} spotWs=null; }
      if (futWs)  { try { futWs.onclose=null; futWs.close(); } catch(e){} futWs=null; }
      if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer=null; }

      localBids = {}; localAsks = {};
      const streams = symbol + "@bookTicker/" + symbol + "@depth20@100ms";
      const url = "wss://stream.binance.com:9443/stream?streams=" + streams;
      console.log("[Binance] try", url);
      spotWs = new WebSocket(url);

      spotWs.onopen = () => {
        reconnectAttempts = 0;
        depthSource = SRC.BINANCE;
        updateStatusUI();
        pushFeed("Binance depth connected", "win");
      };

      spotWs.onmessage = (evt) => {
        try {
          const raw = JSON.parse(evt.data);
          const msg = raw.data || raw;

          if (msg.b != null && msg.a != null) {
            const bid = parseFloat(msg.b), ask = parseFloat(msg.a);
            if (bid > 0 && ask > 0) {
              const mid = (bid+ask)/2;
              lastPrice = price;
              price = mid;
              lastPriceTs = Date.now();
              priceHistory.push(mid);
              if (priceHistory.length > 40) priceHistory.shift();
              priceSource = SRC.BINANCE;
              isLive = true;
            }
          }

          const bids = msg.bids || (Array.isArray(msg.b) ? msg.b : null);
          const asks = msg.asks || (Array.isArray(msg.a) ? msg.a : null);
          if (bids && asks) {
            localBids = {}; localAsks = {};
            bids.forEach(l => { const p=+l[0], q=+l[1]; if (q>0) localBids[p]=q; });
            asks.forEach(l => { const p=+l[0], q=+l[1]; if (q>0) localAsks[p]=q; });
            const w = calcWalls();
            if (w.buy > 0.01) buyWall = w.buy;
            if (w.sell > 0.01) sellWall = w.sell;
            lastDepthTs = Date.now();
            depthSource = SRC.BINANCE;
            updateStatusUI();
          }
        } catch(e) {}
      };

      spotWs.onclose = () => {
        depthSource = SRC.SIM;
        if (priceSource === SRC.BINANCE) priceSource = SRC.GECKO;
        updateStatusUI();
        pushFeed("Binance depth closed — using CoinGecko/Sim", "info");
        scheduleBinanceReconnect(symbol);
      };
      spotWs.onerror = () => {};

      try {
        futWs = new WebSocket("wss://fstream.binance.com/market/ws/" + symbol + "@forceOrder");
        futWs.onmessage = (evt) => {
          try {
            const raw = JSON.parse(evt.data);
            const o = (raw.data || raw).o || raw;
            if (!o || o.q == null) return;
            const usd = parseFloat(o.q) * parseFloat(o.p || o.ap || 0);
            if (usd < 800) return;
            const side = (o.S || "").toUpperCase();
            const sizeM = (usd/1e6).toFixed(2);
            const power = Math.min(2.8, 0.7 + usd/500000);
            if (side === "SELL") {
              const lost = Math.max(1, Math.round(usd/150000));
              pushFeed("Liquidated long • $" + sizeM + "M  Bulls -" + lost + " units", "loss");
              const zz = (Math.random()-0.5)*15;
              launchStrike(targetX + 12, targetX - 6, zz, 0xf87171, power);
              createExplosion(targetX - 7, zz, 0xf87171, power);
              buyWall = Math.max(0.25, buyWall * 0.92);
              playLiq();
            } else {
              const lost = Math.max(1, Math.round(usd/150000));
              pushFeed("Liquidated short • $" + sizeM + "M  Bears -" + lost + " units", "liq");
              const zz = (Math.random()-0.5)*15;
              launchStrike(targetX - 12, targetX + 6, zz, tokens[current].color, power);
              createExplosion(targetX + 7, zz, tokens[current].color, power);
              sellWall = Math.max(0.25, sellWall * 0.92);
              playLiq();
            }
          } catch(e) {}
        };
      } catch(e) {}
    }

    function scheduleBinanceReconnect(symbol) {
      if (reconnectTimer) return;
      reconnectAttempts++;
      const delay = Math.min(20000, 2000 * Math.pow(1.5, reconnectAttempts));
      reconnectTimer = setTimeout(() => {
        reconnectTimer = null;
        connectBinance(symbol);
      }, delay);
    }

    function connectLive(symbol) {
      if (symbol) connectBinance(symbol);
    }

    function fmtTvl(v) {
      if (v == null || isNaN(v)) return "$—";
      if (v >= 1e6) return "$" + (v/1e6).toFixed(2) + "M";
      if (v >= 1e3) return "$" + (v/1e3).toFixed(1) + "K";
      return "$" + Math.round(v);
    }

    async function fetchChainTvl() {
      try {
        const res = await fetch("https://api.llama.fi/v2/chains", { cache: "no-store" });
        const chains = await res.json();
        const terra = chains.find(c => c.name === "Terra Classic");
        const el = document.getElementById("tvlValue");
        if (el && terra) el.textContent = fmtTvl(terra.tvl);
      } catch(e) { console.warn("[Llama chain]", e.message); }
    }

    async function fetchProtocolTvl(slug, elId) {
      try {
        const res = await fetch("https://api.llama.fi/tvl/" + slug, { cache: "no-store" });
        const tvl = await res.json();
        const el = document.getElementById(elId);
        if (el) el.textContent = fmtTvl(typeof tvl === "number" ? tvl : null);
      } catch(e) {}
    }

    async function fetchCMC() {
      try {
        const url = "https://pro-api.coinmarketcap.com/public-api/v3/cryptocurrency/quotes/latest?id=4172&convert=USD";
        const res = await fetch(url, { cache: "no-store" });
        if (!res.ok) throw new Error("HTTP " + res.status);
        const json = await res.json();
        let coin = null;
        if (json.data) {
          coin = Array.isArray(json.data) ? json.data[0] : (json.data["4172"] || Object.values(json.data)[0]);
        }
        if (!coin) return;
        const quote = (coin.quote && (coin.quote.USD || coin.quote.usd)) || {};
        const mcap = quote.market_cap;
        const rank = coin.cmc_rank || coin.rank;
        const mcapEl = document.getElementById("cmcMcap");
        const rankEl = document.getElementById("cmcRank");
        if (mcapEl && mcap != null) {
          mcapEl.textContent = mcap >= 1e9 ? "$"+(mcap/1e9).toFixed(2)+"B" : "$"+(mcap/1e6).toFixed(2)+"M";
        }
        if (rankEl && rank != null) rankEl.textContent = "#" + rank;
      } catch(e) { console.warn("[CMC]", e.message); }
    }

    function startContextFeeds() {
      const tick = () => {
        fetchChainTvl();
        fetchProtocolTvl("terraport", "tvlTerraport");
        fetchProtocolTvl("garudadefi", "tvlGaruda");
        fetchProtocolTvl("juris-protocol", "tvlJuris");
        fetchCMC();
      };
      tick();
      setInterval(tick, 55000);
    }

    setInterval(() => {
      const age = Date.now() - lastPriceTs;
      if (age > 25000 && priceSource !== SRC.SIM) {
        if (priceSource === SRC.BINANCE) {
          priceSource = SRC.GECKO;
        } else {
          priceSource = SRC.SIM;
          isLive = false;
        }
        updateStatusUI();
      }
      if (depthSource === SRC.BINANCE && Date.now() - lastDepthTs > 20000) {
        depthSource = SRC.SIM;
        updateStatusUI();
      }
    }, 3000);