    function createUnit(color, x, z, type = 0) {
      const group = new THREE.Group();
      const bodyMat = new THREE.MeshStandardMaterial({
        color: color, roughness: 0.45, metalness: 0.15,
        emissive: color, emissiveIntensity: 0.28
      });
      const darkMat = new THREE.MeshStandardMaterial({
        color: 0x0a0f14, roughness: 0.6, metalness: 0.25
      });
      const accentMat = new THREE.MeshStandardMaterial({
        color: 0xf8fafc, roughness: 0.3, metalness: 0.4,
        emissive: color, emissiveIntensity: 0.55
      });

      if (type === 0) {
        const legs = new THREE.Mesh(new THREE.BoxGeometry(0.38, 0.35, 0.28), bodyMat);
        legs.position.y = 0.22;
        const torso = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.45, 0.3), bodyMat);
        torso.position.y = 0.58;
        const head = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.26, 0.26), accentMat);
        head.position.y = 0.95;
        const gun = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.08, 0.42), darkMat);
        gun.position.set(0.28, 0.55, 0.2);
        group.add(legs, torso, head, gun);
      } else if (type === 1) {
        const hull = new THREE.Mesh(new THREE.BoxGeometry(1.15, 0.4, 0.85), bodyMat);
        hull.position.y = 0.35;
        const skirt = new THREE.Mesh(new THREE.BoxGeometry(1.25, 0.18, 0.95), darkMat);
        skirt.position.y = 0.14;
        const turret = new THREE.Mesh(new THREE.BoxGeometry(0.55, 0.32, 0.55), bodyMat);
        turret.position.y = 0.72;
        const barrel = new THREE.Mesh(new THREE.BoxGeometry(0.14, 0.14, 0.95), darkMat);
        barrel.position.set(0, 0.72, 0.65);
        const hatch = new THREE.Mesh(new THREE.BoxGeometry(0.22, 0.1, 0.22), accentMat);
        hatch.position.y = 0.92;
        group.add(hull, skirt, turret, barrel, hatch);
      } else {
        const base = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.35, 0.7), bodyMat);
        base.position.y = 0.25;
        const body = new THREE.Mesh(new THREE.BoxGeometry(0.55, 0.7, 0.5), bodyMat);
        body.position.y = 0.75;
        const tubeL = new THREE.Mesh(new THREE.BoxGeometry(0.16, 0.16, 0.9), darkMat);
        tubeL.position.set(-0.2, 1.05, 0.35);
        const tubeR = tubeL.clone();
        tubeR.position.x = 0.2;
        const tipL = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.18, 0.18), accentMat);
        tipL.position.set(-0.2, 1.05, 0.85);
        const tipR = tipL.clone();
        tipR.position.x = 0.2;
        group.add(base, body, tubeL, tubeR, tipL, tipR);
      }

      const shadow = new THREE.Mesh(
        new THREE.CircleGeometry(type === 1 ? 0.7 : 0.4, 12),
        new THREE.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.35 })
      );
      shadow.rotation.x = -Math.PI / 2;
      shadow.position.y = 0.03;
      group.add(shadow);

      group.position.set(x, 0, z);
      group.userData = { type };
      scene.add(group);
      return group;
    }

    const bulls = [];
    const bears = [];

    function rebuildUnits() {
      [...bulls, ...bears].forEach(u => scene.remove(u));
      bulls.length = 0; bears.length = 0;

      const bullCount = Math.min(64, Math.floor(16 + buyWall * 14));
      const bearCount = Math.min(64, Math.floor(16 + sellWall * 14));

      function placeArmy(list, color, side) {
        const frontX = side * 7.5;
        for (let i = 0; i < list; i++) {
          const r = Math.random();
          let type = 0;
          if (r > 0.78) type = 2;
          else if (r > 0.55) type = 1;

          const rank = type === 0 ? 0 : (type === 1 ? 1 : 2);
          const x = frontX + side * (3.5 + rank * 5.5 + Math.random() * 3.5);
          const z = (Math.random() - 0.5) * 44;
          const u = createUnit(color, x, z, type);
          if (side < 0) bulls.push(u); else bears.push(u);
        }
      }
      placeArmy(bullCount, tokens[current].color, -1);
      placeArmy(bearCount, 0xf87171, +1);
      lastRebuild = Date.now();
    }
    rebuildUnits();

    const particles = [];
    const projectiles = [];

    function launchStrike(fromX, toX, z, color, power) {
      const rocket = new THREE.Mesh(
        new THREE.ConeGeometry(0.18, 0.7, 6),
        new THREE.MeshBasicMaterial({ color: color })
      );
      rocket.rotation.z = Math.PI / 2;
      if (toX < fromX) rocket.rotation.z = -Math.PI / 2;
      rocket.position.set(fromX, 2.2 + Math.random(), z);
      rocket.userData = {
        tx: toX,
        speed: 0.55 + power * 0.25,
        life: 2.5,
        color,
        power
      };
      scene.add(rocket);
      projectiles.push(rocket);
    }

    function createExplosion(x, z, color, power = 1, isBurn = false) {
      const count = Math.floor((isBurn ? 70 : 45) * Math.min(power, 2));
      for (let i = 0; i < count; i++) {
        const size = 0.15 + Math.random() * 0.35 * power;
        const p = new THREE.Mesh(
          new THREE.BoxGeometry(size, size, size),
          new THREE.MeshBasicMaterial({
            color: isBurn ? (Math.random() > 0.4 ? 0xfde68a : 0xf59e0b) : color,
            transparent: true,
            opacity: 1
          })
        );
        p.position.set(
          x + (Math.random() - 0.5) * 1.8,
          0.8 + Math.random() * 1.2,
          z + (Math.random() - 0.5) * 1.8
        );
        p.userData = {
          vx: (Math.random() - 0.5) * 1.6 * power,
          vy: 0.6 + Math.random() * 1.3 * power,
          vz: (Math.random() - 0.5) * 1.6 * power,
          life: 0.7 + Math.random() * 0.5,
          isSmoke: false
        };
        scene.add(p);
        particles.push(p);
      }
      const flash = new THREE.Mesh(
        new THREE.CircleGeometry(0.8 * power, 12),
        new THREE.MeshBasicMaterial({
          color: isBurn ? 0xfbbf24 : color,
          transparent: true,
          opacity: 0.85
        })
      );
      flash.rotation.x = -Math.PI / 2;
      flash.position.set(x, 0.2, z);
      flash.userData = { vx: 0, vy: 0, vz: 0, life: 0.35, isSmoke: false };
      scene.add(flash);
      particles.push(flash);

      if (power > 0.9 || isBurn) {
        const light = new THREE.PointLight(isBurn ? 0xfbbf24 : color, isBurn ? 7 : 4, 40);
        light.position.set(x, 5, z);
        scene.add(light);
        setTimeout(() => scene.remove(light), 280);
      }
      cameraShake = Math.min(1.6, cameraShake + (isBurn ? 0.7 : 0.35) * power);
    }

